# ============================================================================
# ROOT HTACCESS FOR HOSTINGER DEPLOYMENT - NEXT.JS STATIC EXPORT
# ============================================================================
# Purpose: Handle redirects, URL rewrites, security, and GSC indexing issues
# Last Updated: Feb 2026
# ============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # ========================================================================
    # 0. SERVICE URL RESTRUCTURE (Oct 2026)
    # Service pages moved from /services/<slug>/ to /<slug>/, and the safety-net
    # services gained a "-nets" suffix. Absolute targets, and placed before the
    # host/HTTPS/trailing-slash rules, so every old URL reaches its new address
    # in a single 301. Keep in sync with SERVICE_URL_SLUGS in data/servicesData.ts.
    # ========================================================================
    # Renamed services (with or without city / area segments)
    RewriteRule ^services/balcony-safety/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/balcony-safety-nets/$1/ [R=301,L]
    RewriteRule ^services/balcony-safety/?$ https://invisiblegrillsandsafetynets.in/balcony-safety-nets/ [R=301,L]
    RewriteRule ^services/children-protection/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/children-safety-nets/$1/ [R=301,L]
    RewriteRule ^services/children-protection/?$ https://invisiblegrillsandsafetynets.in/children-safety-nets/ [R=301,L]
    RewriteRule ^services/pets-safety/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/pet-safety-nets/$1/ [R=301,L]
    RewriteRule ^services/pets-safety/?$ https://invisiblegrillsandsafetynets.in/pet-safety-nets/ [R=301,L]
    RewriteRule ^services/grill-balcony/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/grill-balcony-safety-nets/$1/ [R=301,L]
    RewriteRule ^services/grill-balcony/?$ https://invisiblegrillsandsafetynets.in/grill-balcony-safety-nets/ [R=301,L]
    RewriteRule ^services/terrace-top/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/terrace-top-nets/$1/ [R=301,L]
    RewriteRule ^services/terrace-top/?$ https://invisiblegrillsandsafetynets.in/terrace-top-nets/ [R=301,L]
    RewriteRule ^services/industrial-safety/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/industrial-safety-nets/$1/ [R=301,L]
    RewriteRule ^services/industrial-safety/?$ https://invisiblegrillsandsafetynets.in/industrial-safety-nets/ [R=301,L]
    RewriteRule ^services/duct-area/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/duct-area-nets/$1/ [R=301,L]
    RewriteRule ^services/duct-area/?$ https://invisiblegrillsandsafetynets.in/duct-area-nets/ [R=301,L]
    RewriteRule ^services/open-area/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/open-area-safety-nets/$1/ [R=301,L]
    RewriteRule ^services/open-area/?$ https://invisiblegrillsandsafetynets.in/open-area-safety-nets/ [R=301,L]
    RewriteRule ^services/staircase-safety/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/staircase-safety-nets/$1/ [R=301,L]
    RewriteRule ^services/staircase-safety/?$ https://invisiblegrillsandsafetynets.in/staircase-safety-nets/ [R=301,L]
    RewriteRule ^services/construction-safety/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/construction-safety-nets/$1/ [R=301,L]
    RewriteRule ^services/construction-safety/?$ https://invisiblegrillsandsafetynets.in/construction-safety-nets/ [R=301,L]
    RewriteRule ^services/hdpe-nylon/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/hdpe-nylon-nets/$1/ [R=301,L]
    RewriteRule ^services/hdpe-nylon/?$ https://invisiblegrillsandsafetynets.in/hdpe-nylon-nets/ [R=301,L]
    RewriteRule ^services/swimming-pool/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/swimming-pool-safety-nets/$1/ [R=301,L]
    RewriteRule ^services/swimming-pool/?$ https://invisiblegrillsandsafetynets.in/swimming-pool-safety-nets/ [R=301,L]
    RewriteRule ^services/car-parking/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/car-parking-nets/$1/ [R=301,L]
    RewriteRule ^services/car-parking/?$ https://invisiblegrillsandsafetynets.in/car-parking-nets/ [R=301,L]
    RewriteRule ^services/monkey-safety/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/monkey-safety-nets/$1/ [R=301,L]
    RewriteRule ^services/monkey-safety/?$ https://invisiblegrillsandsafetynets.in/monkey-safety-nets/ [R=301,L]
    # Same renames for anyone who guesses the old slug at the new root level
    RewriteRule ^balcony-safety/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/balcony-safety-nets/$1/ [R=301,L]
    RewriteRule ^balcony-safety/?$ https://invisiblegrillsandsafetynets.in/balcony-safety-nets/ [R=301,L]
    RewriteRule ^children-protection/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/children-safety-nets/$1/ [R=301,L]
    RewriteRule ^children-protection/?$ https://invisiblegrillsandsafetynets.in/children-safety-nets/ [R=301,L]
    RewriteRule ^pets-safety/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/pet-safety-nets/$1/ [R=301,L]
    RewriteRule ^pets-safety/?$ https://invisiblegrillsandsafetynets.in/pet-safety-nets/ [R=301,L]
    RewriteRule ^grill-balcony/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/grill-balcony-safety-nets/$1/ [R=301,L]
    RewriteRule ^grill-balcony/?$ https://invisiblegrillsandsafetynets.in/grill-balcony-safety-nets/ [R=301,L]
    RewriteRule ^terrace-top/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/terrace-top-nets/$1/ [R=301,L]
    RewriteRule ^terrace-top/?$ https://invisiblegrillsandsafetynets.in/terrace-top-nets/ [R=301,L]
    RewriteRule ^industrial-safety/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/industrial-safety-nets/$1/ [R=301,L]
    RewriteRule ^industrial-safety/?$ https://invisiblegrillsandsafetynets.in/industrial-safety-nets/ [R=301,L]
    RewriteRule ^duct-area/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/duct-area-nets/$1/ [R=301,L]
    RewriteRule ^duct-area/?$ https://invisiblegrillsandsafetynets.in/duct-area-nets/ [R=301,L]
    RewriteRule ^open-area/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/open-area-safety-nets/$1/ [R=301,L]
    RewriteRule ^open-area/?$ https://invisiblegrillsandsafetynets.in/open-area-safety-nets/ [R=301,L]
    RewriteRule ^staircase-safety/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/staircase-safety-nets/$1/ [R=301,L]
    RewriteRule ^staircase-safety/?$ https://invisiblegrillsandsafetynets.in/staircase-safety-nets/ [R=301,L]
    RewriteRule ^construction-safety/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/construction-safety-nets/$1/ [R=301,L]
    RewriteRule ^construction-safety/?$ https://invisiblegrillsandsafetynets.in/construction-safety-nets/ [R=301,L]
    RewriteRule ^hdpe-nylon/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/hdpe-nylon-nets/$1/ [R=301,L]
    RewriteRule ^hdpe-nylon/?$ https://invisiblegrillsandsafetynets.in/hdpe-nylon-nets/ [R=301,L]
    RewriteRule ^swimming-pool/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/swimming-pool-safety-nets/$1/ [R=301,L]
    RewriteRule ^swimming-pool/?$ https://invisiblegrillsandsafetynets.in/swimming-pool-safety-nets/ [R=301,L]
    RewriteRule ^car-parking/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/car-parking-nets/$1/ [R=301,L]
    RewriteRule ^car-parking/?$ https://invisiblegrillsandsafetynets.in/car-parking-nets/ [R=301,L]
    RewriteRule ^monkey-safety/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/monkey-safety-nets/$1/ [R=301,L]
    RewriteRule ^monkey-safety/?$ https://invisiblegrillsandsafetynets.in/monkey-safety-nets/ [R=301,L]
    # Every other service: just drop the /services prefix. (/services/ itself,
    # the listing page, has no second segment and is left alone.)
    RewriteRule ^services/([^/.]+)/([^.]*[^/.])/?$ https://invisiblegrillsandsafetynets.in/$1/$2/ [R=301,L]
    RewriteRule ^services/([^/.]+)/?$ https://invisiblegrillsandsafetynets.in/$1/ [R=301,L]

    # ========================================================================
    # CANONICAL DOMAIN: Redirect www to non-www (preserve path/query)
    # Ensures a single preferred host for SEO (https://invisiblegrillsandsafetynets.in)
    # ========================================================================
    RewriteCond %{HTTP_HOST} ^www\.invisiblegrillsandsafetynets\.in$ [NC]
    RewriteRule ^ https://invisiblegrillsandsafetynets.in%{REQUEST_URI} [L,R=301]
    
    # ========================================================================
    # 1. FORCE HTTPS (Critical for SEO)
    # ========================================================================
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # ========================================================================
    # 2. HANDLE MALFORMED URLS
    # ========================================================================
    # Remove double slashes (except in https://)
    RewriteCond %{THE_REQUEST} //
    RewriteRule .* /$0 [R=301,L]
    
    # Handle trailing special characters
    RewriteRule ^(.*)[&?]+$ /$1 [L,R=301]
    
    # ========================================================================
    # 3. ENSURE TRAILING SLASHES FOR ALL PAGES (Critical for GSC)
    # ========================================================================
    # Redirect files to directories with trailing slash
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !\.html$
    RewriteCond %{REQUEST_URI} !\.json$
    RewriteCond %{REQUEST_URI} !\.xml$
    RewriteCond %{REQUEST_URI} !\.txt$
    RewriteRule ^(.+)$ /$1/ [R=301,L]
    
    # ========================================================================
    # 4. OLD URL TO NEW URL REDIRECTS (GSC Redirect Errors Fix)
    # ========================================================================
    # Service slug redirects - all with trailing slash destination
    RewriteRule ^grill/?$ /invisible-grills/ [R=301,L]
    RewriteRule ^grills/?$ /invisible-grills/ [R=301,L]
    RewriteRule ^nets/?$ /balcony-safety-nets/ [R=301,L]
    RewriteRule ^net/?$ /balcony-safety-nets/ [R=301,L]
    RewriteRule ^safety-net/?$ /balcony-safety-nets/ [R=301,L]
    RewriteRule ^invisible-grill/?$ /invisible-grills/ [R=301,L]
    RewriteRule ^contact-us/?$ /contact/ [R=301,L]
    RewriteRule ^about-us/?$ /about/ [R=301,L]
    
    # ========================================================================
    # 5. NEXT.JS STATIC EXPORT ROUTING (Critical for Hostinger)
    # ========================================================================
    # If the requested resource exists as a file, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule .* - [L]
    
    # If the requested resource exists as a directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule .* - [L]
    
    # Try to serve .html version if it exists (for static HTML files)
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L]
    
    # Fallback to index.html for client-side routing
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule .* /index.html [L]
</IfModule>

# ============================================================================
# SECURITY HEADERS (Hostinger + GSC Optimization)
# ============================================================================
<IfModule mod_headers.c>
    # Remove server signature
    Header always unset "X-Powered-By"
    Header always unset "Server"
    
    # Security headers for better crawlability
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    
    # Cache Control - HTML pages (no cache for GSC freshness)
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
        Header set Pragma "public"
    </FilesMatch>
    
    # Fonts are assets, not pages - keep them out of Google's index reports
    <FilesMatch "\.(woff|woff2|ttf|eot|otf)$">
        Header set X-Robots-Tag "noindex"
    </FilesMatch>

    # Cache Control - CSS, JS (long cache)
    <FilesMatch "\.(css|js|json)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Cache Control - Images (long cache)
    <FilesMatch "\.(jpg|jpeg|png|gif|ico|svg|webp|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ============================================================================
# ETAG CONFIGURATION (For cache validation)
# ============================================================================
<FilesMatch "\.(html|css|js|json|xml|txt)$">
    FileETag All
</FilesMatch>

# ============================================================================
# COMPRESSION (Gzip + Brotli for better performance)
# ============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE application/rss+xml application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
    AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript application/json
</IfModule>

# ============================================================================
# ERROR PAGES & SECURITY
# ============================================================================
ErrorDocument 404 /404.html
Options -Indexes

# ============================================================================
# HOSTINGER-SPECIFIC OPTIMIZATIONS
# ============================================================================
# Disable PHP/CGI/other unwanted handlers
<FilesMatch "\.(php|phtml|php3|php4|php5|pht|phar|phps|shtml|ctp|ihtml|php7|phps|pht|phtml|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
# The deploy branch carries a stub package.json purely to satisfy Hostinger's
# Git pipeline, which refuses to deploy a repository without one. It is build
# metadata, not site content, so keep it out of the web root's public surface.
<FilesMatch "^(package(-lock)?\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
